{
  "version": "1.0.0",
  "copybookId": "hvac-check-family-copybook-v1",
  "scope": "unified check-family short copy",
  "mainTemplates": {
    "check_pass": {
      "zh": {
        "mobileShortMain": "检查通过",
        "fullMain": "检查状态：PASS"
      },
      "en": {
        "mobileShortMain": "Check Pass",
        "fullMain": "Check Status: PASS"
      },
      "vi": {
        "mobileShortMain": "Kiem tra dat",
        "fullMain": "Trang thai kiem tra: PASS"
      }
    },
    "check_fail": {
      "zh": {
        "mobileShortMain": "检查失败",
        "fullMain": "检查状态：FAIL"
      },
      "en": {
        "mobileShortMain": "Check Fail",
        "fullMain": "Check Status: FAIL"
      },
      "vi": {
        "mobileShortMain": "Kiem tra that bai",
        "fullMain": "Trang thai kiem tra: FAIL"
      }
    },
    "check_unknown": {
      "zh": {
        "mobileShortMain": "检查未知",
        "fullMain": "检查状态：UNKNOWN"
      },
      "en": {
        "mobileShortMain": "Check Unknown",
        "fullMain": "Check Status: UNKNOWN"
      },
      "vi": {
        "mobileShortMain": "Kiem tra chua ro",
        "fullMain": "Trang thai kiem tra: UNKNOWN"
      }
    }
  },
  "families": [
    {
      "familyId": "release-ready-check",
      "fieldScope": [
        "decision",
        "exitCode",
        "reasons[]",
        "advisories[]"
      ],
      "priorityOrder": [
        "check_fail",
        "check_unknown",
        "check_pass"
      ],
      "states": {
        "check_pass": {
          "templateRef": "check_pass",
          "trigger": {
            "mode": "all",
            "conditions": [
              "decision == 'GO'",
              "exitCode == 0",
              "reasons.length == 0"
            ]
          },
          "firstAction": {
            "zh": "按窗口继续发布确认",
            "en": "Continue release confirmation in window",
            "vi": "Tiep tuc xac nhan phat hanh theo cua so"
          }
        },
        "check_fail": {
          "templateRef": "check_fail",
          "trigger": {
            "mode": "any",
            "conditions": [
              "decision == 'NO-GO'",
              "exitCode == 1",
              "reasons.length > 0"
            ]
          },
          "firstAction": {
            "zh": "先处理首个 reason 后重跑",
            "en": "Fix first reason then rerun",
            "vi": "Xu ly reason dau tien roi chay lai"
          }
        },
        "check_unknown": {
          "templateRef": "check_unknown",
          "trigger": {
            "mode": "any",
            "conditions": [
              "decision is missing or decision not in ['GO','NO-GO']",
              "exitCode is missing or exitCode not in [0,1]"
            ]
          },
          "firstAction": {
            "zh": "先重跑 release-ready-check",
            "en": "Rerun release-ready-check first",
            "vi": "Chay lai release-ready-check truoc"
          }
        }
      }
    },
    {
      "familyId": "sync-check",
      "fieldScope": [
        "decision",
        "exitCode",
        "steps.releaseReady.ok",
        "steps.releaseReadyCheck.ok",
        "steps.releaseReadyLatest.ok"
      ],
      "priorityOrder": [
        "check_fail",
        "check_unknown",
        "check_pass"
      ],
      "states": {
        "check_pass": {
          "templateRef": "check_pass",
          "trigger": {
            "mode": "all",
            "conditions": [
              "decision == 'GO'",
              "exitCode == 0",
              "steps.releaseReady.ok == true",
              "steps.releaseReadyCheck.ok == true",
              "steps.releaseReadyLatest.ok == true"
            ]
          },
          "firstAction": {
            "zh": "按窗口继续同步放行",
            "en": "Proceed with sync release in window",
            "vi": "Tiep tuc dong bo phat hanh theo cua so"
          }
        },
        "check_fail": {
          "templateRef": "check_fail",
          "trigger": {
            "mode": "any",
            "conditions": [
              "decision == 'NO-GO'",
              "exitCode == 1",
              "steps.releaseReady.ok == false",
              "steps.releaseReadyCheck.ok == false",
              "steps.releaseReadyLatest.ok == false"
            ]
          },
          "firstAction": {
            "zh": "先修复失败步骤再重跑",
            "en": "Fix failed step then rerun",
            "vi": "Sua buoc loi roi chay lai"
          }
        },
        "check_unknown": {
          "templateRef": "check_unknown",
          "trigger": {
            "mode": "any",
            "conditions": [
              "decision is missing or decision not in ['GO','NO-GO']",
              "exitCode is missing or exitCode not in [0,1]",
              "decision/exitCode conflicts with steps.*.ok"
            ]
          },
          "firstAction": {
            "zh": "先重跑 sync-check 并核对步骤位",
            "en": "Rerun sync-check and verify step flags",
            "vi": "Chay lai sync-check va doi chieu trang thai buoc"
          }
        }
      }
    },
    {
      "familyId": "brief-check",
      "fieldScope": [
        "briefCheck.ok",
        "exitCode",
        "reasons[]",
        "advisories[]"
      ],
      "priorityOrder": [
        "check_fail",
        "check_unknown",
        "check_pass"
      ],
      "states": {
        "check_pass": {
          "templateRef": "check_pass",
          "trigger": {
            "mode": "all",
            "conditions": [
              "briefCheck.ok == true",
              "exitCode == 0",
              "reasons.length == 0"
            ]
          },
          "firstAction": {
            "zh": "继续值班播报",
            "en": "Continue duty broadcast",
            "vi": "Tiep tuc thong bao truc"
          }
        },
        "check_fail": {
          "templateRef": "check_fail",
          "trigger": {
            "mode": "any",
            "conditions": [
              "briefCheck.ok == false",
              "exitCode == 1",
              "reasons.length > 0"
            ]
          },
          "firstAction": {
            "zh": "先修复结构错误再重跑",
            "en": "Fix structure errors then rerun",
            "vi": "Sua loi cau truc roi chay lai"
          }
        },
        "check_unknown": {
          "templateRef": "check_unknown",
          "trigger": {
            "mode": "any",
            "conditions": [
              "briefCheck.ok/exitCode/reasons/advisories missing",
              "briefCheck.ok conflicts with exitCode"
            ]
          },
          "firstAction": {
            "zh": "先重跑 brief-check 并复核字段",
            "en": "Rerun brief-check and verify fields",
            "vi": "Chay lai brief-check va kiem tra truong"
          }
        }
      }
    },
    {
      "familyId": "verify-gates-check",
      "fieldScope": [
        "overall",
        "passedCount",
        "totalCount",
        "gates[].ok"
      ],
      "priorityOrder": [
        "check_fail",
        "check_unknown",
        "check_pass"
      ],
      "states": {
        "check_pass": {
          "templateRef": "check_pass",
          "trigger": {
            "mode": "all",
            "conditions": [
              "overall == 'PASS'",
              "passedCount == totalCount",
              "all(gates[].ok == true)"
            ]
          },
          "firstAction": {
            "zh": "继续发布门禁流程",
            "en": "Continue gate-driven release flow",
            "vi": "Tiep tuc quy trinh phat hanh theo gate"
          }
        },
        "check_fail": {
          "templateRef": "check_fail",
          "trigger": {
            "mode": "all",
            "conditions": [
              "overall == 'FAIL'",
              "exists(gates[].ok == false)"
            ]
          },
          "firstAction": {
            "zh": "先处理失败 gate 后重跑",
            "en": "Fix failed gates then rerun",
            "vi": "Xu ly gate loi roi chay lai"
          }
        },
        "check_unknown": {
          "templateRef": "check_unknown",
          "trigger": {
            "mode": "any",
            "conditions": [
              "overall missing or invalid",
              "passedCount/totalCount missing or invalid",
              "gates[].ok missing or invalid"
            ]
          },
          "firstAction": {
            "zh": "先重跑 verify-gates --json",
            "en": "Rerun verify-gates --json first",
            "vi": "Chay lai verify-gates --json truoc"
          }
        }
      }
    }
  ],
  "boundary": {
    "changeRuleId": false,
    "changeThresholds": false,
    "changeEvaluator": false
  }
}
