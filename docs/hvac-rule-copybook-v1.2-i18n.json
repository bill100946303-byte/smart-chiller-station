            "action": "Kiểm tra phiên bản -> từ điển -> hợp đồng"
          }
        }
      },
      "riskMapping": {
        "risk": {
          "high": "Rủi ro cao",
          "medium": "Rủi ro trung bình",
          "low": "Rủi ro thấp"
        }
      }
    }
  },
  "zhFallbackWhitelist": [
    "ruleCopy.<ruleId>.nameZh",
    "ruleCopy.<ruleId>.descriptionZh",
    "ruleCopy.<ruleId>.opsAdviceZh",
    "ruleCopy.<ruleId>.executionChecklist.step1",
    "ruleCopy.<ruleId>.executionChecklist.step2",
    "ruleCopy.<ruleId>.executionChecklist.step3",
    "skippedPlaybook.<category>.order[]",
    "skippedPlaybook.<category>.templates[]",
    "riskMapping.severity.critical",
    "riskMapping.severity.major",
    "riskMapping.severity.minor",
    "riskNarrativePolicy.high",
    "riskNarrativePolicy.medium",
    "riskNarrativePolicy.low",
    "fallbackCopy.unknownRuleId.title",
    "fallbackCopy.unknownRuleId.description",
    "fallbackCopy.unknownRuleId.opsAdvice",
    "fallbackCopy.unknownRuleId.shortText.shortTitle",
    "fallbackCopy.unknownRuleId.shortText.shortReason",
    "fallbackCopy.unknownRuleId.shortText.shortAction",
    "fallbackCopy.unknownSkippedCategory",
    "placementTemplates.recommendation",
    "placementTemplates.ruleSkip",
    "compatibility",
    "diffFromV1",
    "diffFromV1_1",
    "rollback"
  ]
}
