{
  "version": "1.2.0-i18n-min",
  "basedOn": "hvac-rule-copybook-v1.2@1.2.0",
  "fallbackLocale": "zh-CN",
  "supportedLocales": [
    "en",
    "vi"
  ],
  "coverage": {
    "ruleShortTextFields": [
      "ruleCopy.<ruleId>.shortText.shortTitle",
      "ruleCopy.<ruleId>.shortText.shortReason",
      "ruleCopy.<ruleId>.shortText.shortAction"
    ],
    "skippedShortCopyFields": [
      "skippedPlaybook.<category>.shortCopy.main",
      "skippedPlaybook.<category>.shortCopy.detail",
      "skippedPlaybook.<category>.shortCopy.action"
    ],
    "riskShortFields": [
      "riskMapping.risk.high",
      "riskMapping.risk.medium",
      "riskMapping.risk.low"
    ]
  },
  "locales": {
    "en": {
      "ruleCopy": {
        "low-delta-t-chilled-loop": {
          "shortText": {
            "shortTitle": "Low Delta-T",
            "shortReason": "Low delta-T under load",
            "shortAction": "Check bypass, tune CHWS setpoint"
          }
        },
        "pump-frequency-too-high": {
          "shortText": {
            "shortTitle": "Pump Hz High",
            "shortReason": "High Hz, limited heat-transfer gain",
            "shortAction": "Reduce by 2Hz, watch dP"
          }
        },
        "cooling-side-low-efficiency": {
          "shortText": {
            "shortTitle": "Cooling Side Low Eff.",
            "shortReason": "Weak heat rejection, low COP",
            "shortAction": "Tune tower fans, inspect condenser"
          }
        },
        "frequent-start-stop": {
          "shortText": {
            "shortTitle": "Frequent Cycling",
            "shortReason": "Too many starts/stops in short window",
            "shortAction": "Enable min on/off lockout"
          }
        },
        "stale-data-detection": {
          "shortText": {
            "shortTitle": "Stale Data",
            "shortReason": "Key data delayed or missing",
            "shortAction": "Restore data link before tuning"
          }
        }
      },
      "skippedPlaybook": {
        "upstream_unreachable": {
          "shortCopy": {
            "main": "Upstream Down",
            "detail": "No upstream data; rule skipped",
            "action": "Check service -> network -> port"
          }
        },
        "field_missing_or_invalid": {
          "shortCopy": {
            "main": "Field Invalid",
            "detail": "Required fields missing/invalid; skipped",
            "action": "Check mapping, units, then sampling"
          }
        },
        "unknown": {
          "shortCopy": {
            "main": "Unknown Status",
            "detail": "No template matched; downgraded view",
            "action": "Check version -> dictionary -> contract"
          }
        }
      },
      "riskMapping": {
        "risk": {
          "high": "High risk",
          "medium": "Medium risk",
          "low": "Low risk"
        }
      }
    },
    "vi": {
      "ruleCopy": {
        "low-delta-t-chilled-loop": {
          "shortText": {
            "shortTitle": "Delta-T thấp",
            "shortReason": "Delta-T thấp khi tải vẫn cao",
            "shortAction": "Kiểm tra bypass, chỉnh nước cấp"
          }
        },
        "pump-frequency-too-high": {
          "shortText": {
            "shortTitle": "Tần số bơm cao",
            "shortReason": "Hz cao nhưng trao đổi nhiệt tăng ít",
            "shortAction": "Giảm 2Hz mỗi bước, theo dõi dP"
          }
        },
        "cooling-side-low-efficiency": {
          "shortText": {
            "shortTitle": "Giải nhiệt kém",
            "shortReason": "Thải nhiệt yếu, COP thấp",
            "shortAction": "Chỉnh quạt tháp, kiểm tra bình ngưng"
          }
        },
        "frequent-start-stop": {
          "shortText": {
            "shortTitle": "Đóng cắt nhiều",
