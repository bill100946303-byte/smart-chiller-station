{
  "copybookVersion": "1.3.0",
  "basedOn": "hvac-rule-copybook-v1.2@1.2.0",
  "ruleSetRef": "hvac-rules-v1@1.0.1",
  "ruleCopy": {
    "low-delta-t-chilled-loop": {
      "nameZh": "冷冻侧低温差",
      "descriptionZh": "在有一定负荷时，冷冻水温差持续偏低，通常表示换热利用不足或旁通偏大。",
      "opsAdviceZh": "先查末端阀门与旁通，再校核供水温度设定。",
      "executionChecklist": {
        "step1": "看指标：连续15分钟检查 chilled_delta_t_c 与 station_total_power_kw 是否稳定落入触发区间。",
        "step2": "做动作：优先检查末端阀门/旁通；冷冻供水设定每次仅调整0.5°C。",
        "step3": "验效果：观察30分钟，温差回升且舒适度无明显投诉。"
      },
      "shortText": {
        "shortTitle": "冷冻低温差",
        "shortReason": "温差低且有负荷",
        "shortAction": "查旁通并微调供水"
      },
      "shortTextI18n": {
        "zh": {
          "shortTitle": "冷冻低温差",
          "shortReason": "温差低且有负荷",
          "shortAction": "查旁通并微调供水"
        },
        "en": {
          "shortTitle": "Low Delta-T",
          "shortReason": "Delta-T low under load",
          "shortAction": "Check bypass, tune CHWS"
        },
        "vi": {
          "shortTitle": "Delta-T thap",
          "shortReason": "Delta-T thap khi tai cao",
          "shortAction": "Kiem tra bypass, chinh nuoc cap"
        }
      }
    },
    "pump-frequency-too-high": {
      "nameZh": "冷冻泵高频低效",
      "descriptionZh": "泵频长期偏高但温差提升有限，输配能耗可能偏高。",
      "opsAdviceZh": "下调泵频并观察压差/舒适度，复核压差传感器。",
      "executionChecklist": {
        "step1": "看指标：检查 max_chilled_pump_freq_hz 与 chilled_delta_t_c 的20分钟趋势。",
        "step2": "做动作：按2Hz级差逐步下调泵频，并校核压差传感器与设定点。",
        "step3": "验效果：连续20分钟温差不恶化、压差与末端舒适度满足要求。"
      },
      "shortText": {
        "shortTitle": "泵频高低效",
        "shortReason": "高频但换热增益小",
        "shortAction": "每次降2Hz并看压差"
      },
      "shortTextI18n": {
        "zh": {
          "shortTitle": "泵频高低效",
          "shortReason": "高频但换热增益小",
          "shortAction": "每次降2Hz并看压差"
        },
        "en": {
          "shortTitle": "Pump Hz High",
          "shortReason": "High Hz, weak transfer",
          "shortAction": "Drop 2Hz, watch dP"
        },
        "vi": {
          "shortTitle": "Tan so bom cao",
          "shortReason": "Hz cao, truyen nhiet yeu",
          "shortAction": "Giam 2Hz, theo doi dP"
        }
      }
    },
    "cooling-side-low-efficiency": {
      "nameZh": "冷却侧效率偏低",
      "descriptionZh": "冷却侧功率投入较高但散热效果偏弱，系统COP被拖低。",
      "opsAdviceZh": "优化塔风机分级与冷却水设定，检查冷凝器污垢。",
      "executionChecklist": {
        "step1": "看指标：同屏核对 cooling_delta_t_c、cooling_tower_power_kw、station_cop 的20分钟表现。",
        "step2": "做动作：优化塔风机分级与冷却水设定，设定温度单次调整不超过0.5°C；检查冷凝器结垢。",
        "step3": "验效果：1小时内COP提升且冷却侧温差不再持续偏低。"
      },
      "shortText": {
        "shortTitle": "冷却侧低效",
        "shortReason": "散热弱且COP低",
        "shortAction": "调塔风机并查冷凝器"
      },
      "shortTextI18n": {
        "zh": {
          "shortTitle": "冷却侧低效",
          "shortReason": "散热弱且COP低",
          "shortAction": "调塔风机并查冷凝器"
        },
        "en": {
          "shortTitle": "Cooling Low Eff.",
          "shortReason": "Weak rejection, low COP",
          "shortAction": "Tune fans, check condenser"
        },
        "vi": {
          "shortTitle": "Giai nhiet kem",
          "shortReason": "Thai nhiet yeu, COP thap",
          "shortAction": "Chinh quat, kiem tra ngung"
        }
      }
    },
    "frequent-start-stop": {
      "nameZh": "设备频繁启停",
      "descriptionZh": "主机或水泵短时反复启停，存在控制震荡和设备损耗风险。",
      "opsAdviceZh": "启用最小启停锁定时间，放宽控制死区。",
      "executionChecklist": {
        "step1": "看指标：检查 chiller_start_stop_count_60m、chilled_pump_start_stop_count_60m、cooling_pump_start_stop_count_60m。",
        "step2": "做动作：启用最小启停锁定(建议>=10分钟)并放宽死区；禁止连续人工强制启停。",
        "step3": "验效果：连续2小时启停次数回落至阈值以内，且告警不再新增。"
      },
      "shortText": {
        "shortTitle": "频繁启停",
        "shortReason": "短时启停次数过多",
        "shortAction": "锁最小启停，禁手动连启停"
      },
      "shortTextI18n": {
        "zh": {
          "shortTitle": "频繁启停",
          "shortReason": "短时启停次数过多",
          "shortAction": "锁最小启停，禁手动连启停"
        },
        "en": {
          "shortTitle": "Frequent Cycling",
          "shortReason": "Too many starts/stops",
          "shortAction": "Set lockout, no force cycle"
        },
        "vi": {
          "shortTitle": "Dong cat nhieu",
          "shortReason": "So lan dong/cat qua day",
          "shortAction": "Bat lockout, cam dong/cat tay"
        }
      }
    },
    "stale-data-detection": {
      "nameZh": "数据新鲜度不足",
      "descriptionZh": "关键输入数据滞后或缺失，建议可信度下降。",
      "opsAdviceZh": "优先恢复数据链路，再执行节能优化动作。",
      "executionChecklist": {
        "step1": "看指标：核对 overview_data_age_min、anomalies_data_age_min、critical_metric_missing_count_5m。",
        "step2": "做动作：优先恢复采集链路与适配器；数据未恢复前禁止进行大幅节能调参。",
        "step3": "验效果：连续30分钟时效恢复阈值内，缺失计数稳定下降。"
      },
      "shortText": {
        "shortTitle": "数据不新鲜",
        "shortReason": "关键数据滞后或缺失",
        "shortAction": "先恢复链路，单次调参<=0.5C"
      },
      "shortTextI18n": {
        "zh": {
          "shortTitle": "数据不新鲜",
          "shortReason": "关键数据滞后或缺失",
          "shortAction": "先恢复链路，单次调参<=0.5C"
        },
        "en": {
          "shortTitle": "Stale Data",
          "shortReason": "Key data delayed/missing",
          "shortAction": "Restore feed first, step <=0.5C"
        },
        "vi": {
          "shortTitle": "Du lieu cu",
          "shortReason": "Du lieu quan trong tre/thieu",
          "shortAction": "Khoi phuc du lieu, buoc <=0.5C"
        }
      }
    }
  },
  "placementTemplates": {
    "recommendation": {
      "titlePattern": "{nameZh}",
      "summaryPattern": "{descriptionZh}",
      "opsPattern": "执行建议：{step1}；{step2}；{step3}",
      "shortPattern": "{shortTitle}｜{shortReason}｜{shortAction}"
    },
    "ruleSkip": {
      "summaryPattern": "{skipTemplate}",
      "opsPattern": "排障顺序：{orderStep1} -> {orderStep2} -> {orderStep3}",
      "shortPattern": "{main}｜{detail}｜{action}"
    }
  },
