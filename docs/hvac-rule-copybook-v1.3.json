  "riskMapping": {
    "risk": {
      "high": "高风险",
      "medium": "中风险",
      "low": "低风险"
    },
    "severity": {
      "critical": "紧急",
      "major": "重要",
      "minor": "提示"
    }
  },
  "riskNarrativePolicy": {
    "high": {
      "mustInclude": [
        "优先级：P1",
        "操作边界"
      ],
      "template": "优先级：P1。先在安全边界内执行恢复动作。操作边界：单次调整不超过既定步长，调整后至少观察30分钟。",
      "tone": "明确、克制、可执行"
    },
    "medium": {
      "mustAvoid": [
        "立即停机",
        "严重事故"
      ],
      "template": "建议在当班窗口内处理，按检查单逐项执行并记录结果。",
      "tone": "建议式、不过度告警"
    },
    "low": {
      "mustAvoid": [
        "紧急处置",
        "立刻处理"
      ],
      "template": "建议纳入例行巡检，持续观察趋势变化。",
      "tone": "巡检式、轻量提醒"
    }
  },
  "operationalModes": {
    "schema": "shortTitle/shortReason/shortAction + triggerFields",
    "staleMode": {
      "stale_only": {
        "triggerFields": [
          "ruleEvaluation.rulesLoaded === true",
          "ruleEvaluation.matchedRuleIds includes stale-data-detection OR cards[*].ruleId=stale-data-detection",
          "ruleEvaluation.skippedRuleIds.length === 0",
          "overview|trends|anomalies.freshness.stale has true"
        ],
        "shortTextI18n": {
          "zh": {
            "shortTitle": "数据陈旧",
            "shortReason": "当前建议基于旧数据",
            "shortAction": "先校时效再调参"
          },
          "en": {
            "shortTitle": "Data Stale",
            "shortReason": "Recommendations rely on stale data",
            "shortAction": "Validate freshness before tuning"
          },
          "vi": {
            "shortTitle": "Du lieu cu",
            "shortReason": "Khuyen nghi dua tren du lieu cu",
            "shortAction": "Kiem tra do moi truoc khi chinh"
          }
        }
      },
      "stale_with_missing": {
        "triggerFields": [
          "ruleEvaluation.rulesLoaded === true",
          "stale-data-detection matched",
          "ruleEvaluation.skippedRuleIds.length > 0",
          "freshness.stale has true"
        ],
        "shortTextI18n": {
          "zh": {
            "shortTitle": "陈旧且缺指标",
            "shortReason": "数据旧且规则有跳过",
            "shortAction": "先补链路后调参(边界内)"
          },
          "en": {
            "shortTitle": "Stale + Missing",
            "shortReason": "Stale data with skipped rules",
            "shortAction": "Fix feeds first, then tune in-bounds"
          },
          "vi": {
            "shortTitle": "Cu + thieu chi so",
            "shortReason": "Du lieu cu va rule bi bo qua",
            "shortAction": "Sua du lieu truoc, roi chinh trong gioi han"
          }
        }
      },
      "stale_recovered": {
        "triggerFields": [
          "ruleEvaluation.rulesLoaded === true",
          "stale-data-detection not matched",
          "overview|trends|anomalies.freshness.stale all false"
        ],
        "shortTextI18n": {
          "zh": {
            "shortTitle": "时效已恢复",
            "shortReason": "陈旧告警已解除",
            "shortAction": "恢复常规调优并持续观察"
          },
          "en": {
            "shortTitle": "Freshness Restored",
            "shortReason": "Stale condition cleared",
            "shortAction": "Resume normal tuning and monitor"
          },
          "vi": {
            "shortTitle": "Da phuc hoi do tuoi",
            "shortReason": "Canh bao du lieu cu da het",
            "shortAction": "Tro lai toi uu thuong le va theo doi"
          }
        }
      }
    },
    "stationCopMode": {
      "cop_missing_lt_30m": {
        "triggerFields": [
          "missingMetrics has station_cop only",
          "copMissingDurationMin < 30",
          "freshness.stale all false"
        ],
        "shortTextI18n": {
          "zh": {
            "shortTitle": "COP短时缺失",
            "shortReason": "仅COP暂时不可评估",
            "shortAction": "先查映射采样再复核"
          },
          "en": {
            "shortTitle": "Short COP Gap",
            "shortReason": "Only COP temporarily missing",
            "shortAction": "Check mapping/sampling, then verify"
          },
          "vi": {
            "shortTitle": "Thieu COP ngan han",
            "shortReason": "Chi COP tam thoi thieu",
            "shortAction": "Kiem tra mapping/mau roi xac nhan"
          }
        }
      },
      "cop_missing_ge_30m": {
        "triggerFields": [
          "missingMetrics has station_cop only",
          "copMissingDurationMin >= 30"
        ],
        "shortTextI18n": {
          "zh": {
            "shortTitle": "COP持续缺失",
            "shortReason": "缺失>=30分钟影响结论",
            "shortAction": "先补数后回放，未恢复不下结论"
          },
          "en": {
            "shortTitle": "Persistent COP Loss",
            "shortReason": "Missing >=30m impacts decisions",
            "shortAction": "Restore COP then replay; no final claim"
          },
          "vi": {
            "shortTitle": "Thieu COP keo dai",
            "shortReason": "Thieu >=30p anh huong ket luan",
            "shortAction": "Khoi phuc COP roi chay lai; chua ket luan"
          }
        }
      },
      "cop_recovered_30_120m": {
        "triggerFields": [
          "station_cop source ok true",
          "copMissing false",
          "copRecoveredDurationMin between 30 and 120"
        ],
        "shortTextI18n": {
          "zh": {
            "shortTitle": "COP恢复观察",
            "shortReason": "已恢复，需稳定观察",
            "shortAction": "30-120分钟内仅小步调参"
          },
          "en": {
            "shortTitle": "COP Recovery Window",
            "shortReason": "Recovered, needs stability watch",
            "shortAction": "Only small-step tuning for 30-120m"
          },
          "vi": {
            "shortTitle": "Giai doan theo doi COP",
            "shortReason": "Da phuc hoi, can theo doi on dinh",
            "shortAction": "Chi chinh nho trong 30-120p"
          }
        }
      }
    }
  },
