  "metricTemplate": {
    "regex": "^metric\\.([a-z0-9_]+)$",
    "shortLabelRule": "fieldShortCnMap[field] || defaultShortLabel",
    "fullLabelRule": "fieldCnMap[field] ? `规则指标：${fieldCnMap[field]}` : `规则指标：${field}`",
    "defaultShortLabel": "规则指标",
    "unknownFallback": {
      "shortLabel": "规则指标",
      "fullLabelTemplate": "规则指标：{snake_case}",
      "riskHint": "未收录 metric 禁止直接用于业务结论。"
    },
    "fieldCnMap": {
      "chilled_delta_t_c": "冷冻水温差",
      "cooling_delta_t_c": "冷却水温差",
      "station_cop": "冷站COP",
      "station_total_power_kw": "冷站实时总功率"
    },
    "fieldShortCnMap": {
      "chilled_delta_t_c": "冷冻温差",
      "cooling_delta_t_c": "冷却温差",
      "station_cop": "冷站COP",
      "station_total_power_kw": "总站功率"
    }
  },
  "fallback": {
    "shortLabel": "未收录",
    "fullLabelTemplate": "未收录来源（{rawKey}）",
    "riskHint": "未收录 key 禁止直接用于业务结论。"
  },
  "renderingPolicy": {
    "collapsed": {
      "labelField": "shortLabel",
      "reason": "移动端优先，提升密度与可扫读性。"
    },
    "expanded": {
      "labelField": "fullLabel",
      "reason": "排障与解释优先，保留完整语义。"
    }
  },
