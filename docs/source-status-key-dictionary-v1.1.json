  "aliases": {
    "subsystemInfo": "subsystemSummary"
  },
  "statusClassifier": {
    "order": [
      "normal",
      "field_invalid",
      "upstream_unreachable",
      "upstream_service_error",
      "state_abnormal"
    ],
    "rules": [
      {
        "id": "normal",
        "shortText": "正常",
        "when": "ok === true && !error"
      },
      {
        "id": "field_invalid",
        "shortText": "字段缺失或无效",
        "when": "message/error contains field_missing_or_invalid"
      },
      {
        "id": "upstream_unreachable",
        "shortText": "上游不可达",
        "when": "message/error contains upstream_unreachable|fetch failed|timeout|ECONN|ENOTFOUND"
      },
      {
        "id": "upstream_service_error",
        "shortText": "上游服务异常",
        "when": "status >= 500 or status in [502,503,504]"
      },
      {
        "id": "state_abnormal",
        "shortText": "状态异常",
        "when": "ok === false and none of above matched"
      }
    ]
  },
  "summaryPolicy": {
    "formula": {
      "total": "sources.length",
      "abnormal": "count(classification != normal)",
      "hard_block": "count(classification in [upstream_unreachable, upstream_service_error])",
      "field_issue": "count(classification == field_invalid)"
    },
    "summaryText": {
      "all_ok": "来源正常（0/{total}）",
      "has_issue": "来源异常（{abnormal}/{total}）",
      "subline": "阻塞 {hard_block} · 字段问题 {field_issue}"
    },
    "toneRule": {
      "good": "abnormal == 0",
      "warn": "abnormal > 0"
    }
  },
  "dynamicMetric": {
    "regex": "^metric\\.([a-z0-9_]+)$",
    "shortLabelTemplate": "{field_short_cn_or_default}",
    "fullLabelTemplate": "规则指标：{field_cn_or_key}",
    "defaultShortLabel": "规则指标",
    "defaultSourceEndpoint": "ruleMetrics",
    "failHintTemplate": "{field_cn_or_key}指标不可用，请检查字段映射或上游链路。",
    "fieldCnMap": {
      "chilled_delta_t_c": "冷冻水温差",
      "cooling_delta_t_c": "冷却水温差",
      "station_cop": "冷站COP",
      "station_total_power_kw": "冷站实时总功率"
    },
    "fieldShortCnMap": {
      "chilled_delta_t_c": "冷冻温差",
      "cooling_delta_t_c": "冷却温差",
      "station_cop": "冷站COP",
      "station_total_power_kw": "总站功率"
    }
  },
  "fallback": {
    "shortLabel": "未收录",
    "fullLabelTemplate": "未收录来源（{rawKey}）",
    "failHint": "来源语义未收录，请先完成口径校准后再业务化展示。",
    "riskHint": "未收录 key 禁止直接用于业务结论。"
  },
  "opaqueKeysForBusinessView": [
