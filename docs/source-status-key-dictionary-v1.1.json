    ],
    "adjusted": [
      "subsystemInfo 收敛为 subsystemSummary 兼容别名",
      "metric.* 模板增加短标签映射"
    ],
    "compatible": [
      "保持 v1 key 语义与失败主提示主旨不变",
      "不改字段定义与 null_strategy"
    ]
  }
}

