{
  "name": "chiller-shell-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "npm run check:source-status-dict && npm run check:route-scope && npm run check:ui-visible-copy && npm run check:energy-efficiency-ui && npm run check:ai-overview-ui && npm run check:visual-readability",
    "verify": "npm run check && npm run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:source-status-dict": "node scripts/check-source-status-dictionary.js",
    "check:route-scope": "node scripts/check-route-scope.js",
    "check:ui-visible-copy": "node scripts/check-ui-visible-copy.js",
    "check:energy-efficiency-ui": "node scripts/check-energy-efficiency-ui-contract.js",
    "check:ai-overview-ui": "node scripts/check-ai-overview-ui-contract.js",
    "check:visual-readability": "node scripts/check-visual-readability-contract.js",
    "check:energy-efficiency-delivery-scope": "node scripts/check-energy-efficiency-delivery-scope.js"
  },
  "dependencies": {
    "@google/model-viewer": "^4.2.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
