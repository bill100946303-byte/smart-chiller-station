    "allowedStates": ["RUNNING", "FAULT", "STANDBY", "STOPPED", "UNKNOWN"],
    "requiredSignals": ["running", "fault", "remoteEnabled"],
    "strictBinaryValues": [false, true, 0, 1, "0", "1"],
    "precedence": [
      "usable explicit fault=1 => FAULT",
      "fault unavailable or invalid => UNKNOWN",
      "fault=0 and running unavailable or invalid => UNKNOWN",
      "fault=0 and running=1 => RUNNING",
      "fault=0 and running=0 and remoteEnabled unavailable or invalid => UNKNOWN",
      "fault=0 and running=0 and remoteEnabled=1 => STANDBY",
      "fault=0 and running=0 and remoteEnabled=0 => STOPPED"
    ],
    "faultRequirement": "FAULT requires the exact equipment fault selector to contain binary 1; communication failure, missing data and bad quality never imply FAULT",
